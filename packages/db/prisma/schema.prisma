// CasitaCalc — schema Prisma (PostgreSQL)
// Entidades: Project, Opening, Material, Recipe, RecipeItem,
// CalculationResult(+items), PriceList (futura para proveedores).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Visibilidad del proyecto. PRIVATE solo dueño; UNLISTED vía link;
/// PUBLIC requiere aprobación de administración.
enum ProjectVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/// Moderación para publicación pública. Solo PUBLIC+APPROVED aparece en público.
enum ModerationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Project {
  id                  String   @id @default(cuid())
  nombreProyecto      String
  anchoM              Decimal  @db.Decimal(8, 2)
  largoM              Decimal  @db.Decimal(8, 2)
  alturaParedesM      Decimal  @db.Decimal(5, 2)
  sistemaConstructivo String
  tipoTecho           String
  anguloTechoGrados   Decimal  @db.Decimal(5, 2)
  cantidadBanios      Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// SHA-256 hex del token anónimo de la cookie del visitante dueño.
  ownerTokenHash     String
  /// Reservado para migración futura a usuarios registrados.
  userId             String?
  visibility         ProjectVisibility @default(PRIVATE)
  moderationStatus   ModerationStatus  @default(NONE)
  /// Token aleatorio para links /share/[token]; null cuando no se comparte.
  shareToken         String?  @unique

  openings Opening[]
  results  CalculationResult[]

  @@index([ownerTokenHash])
}

model Opening {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tipo     String
  anchoM   Decimal @db.Decimal(6, 2)
  altoM    Decimal @db.Decimal(6, 2)
  cantidad Int

  @@index([projectId])
}

model Material {
  id                       String    @id @default(cuid())
  codigo                   String    @unique
  nombre                   String
  categoria                String
  unidad                   String
  precioDefault            Decimal   @db.Decimal(14, 2)
  precioActual             Decimal   @db.Decimal(14, 2)
  fechaActualizacionPrecio DateTime?
  fuente                   String?

  priceObservations     PriceObservation[]
  materialReferencePrices MaterialReferencePrice[]
}

model Recipe {
  id                  String  @id @default(cuid())
  codigo              String  @unique
  rubro               String
  sistemaConstructivo String?
  tipoTecho           String?
  /// Solo rubro Aberturas: PUERTA o VENTANA.
  tipoAbertura        String?

  items RecipeItem[]
}

model RecipeItem {
  id             String  @id @default(cuid())
  recipeId       String
  recipe         Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  codigoMaterial String
  cantidadPorUnidad Decimal @db.Decimal(12, 4)
  desperdicioPct    Decimal @db.Decimal(5, 2)

  @@index([recipeId])
}

model CalculationResult {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  totalGeneral Decimal @db.Decimal(16, 2)
  geometriaJson Json
  createdAt    DateTime @default(now())

  items CalculationResultItem[]

  @@index([projectId])
}

model CalculationResultItem {
  id             String            @id @default(cuid())
  resultId       String
  result         CalculationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  codigoMaterial String
  nombreMaterial String
  rubro          String
  /// Receta que generó el ítem (ej: REVOQUE_INTERIOR). Null en resultados viejos.
  recetaCodigo   String?
  cantidad       Decimal  @db.Decimal(14, 2)
  unidad         String
  desperdicioPct Decimal @db.Decimal(5, 2)
  cantidadFinal  Decimal @db.Decimal(14, 2)
  precioUnitario Decimal? @db.Decimal(14, 2)
  subtotal       Decimal? @db.Decimal(14, 2)

  /// Trazabilidad del precio aplicado (relevamiento publicado).
  fuentePrecio String?
  fechaPrecio  DateTime?
  regionPrecio String?

  @@index([resultId])
}

// ── Infraestructura de precios normalizados ─────────────────────────────────
//
// Pipeline: CSV/API/skill → NormalizedPriceObservationInput → PriceImportService
//   → PriceCollection + PriceObservation[] → MaterialReferencePrice (mediana).
// Nunca se actualizan precios históricos: cada relevamiento crea filas nuevas.

enum PriceCollectionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  REJECTED
  FAILED
}

enum ReferencePriceStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

/// Fuente de precios registrada (EASY, MERCADOLIBRE, MANUAL, ...).
/// Extensible por datos: agregar una fila no modifica el modelo.
model PriceSource {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collections PriceCollection[]
  observations PriceObservation[]
  referencePrices MaterialReferencePrice[]
}

/// Un relevamiento = un archivo importado. Conserva contadores y estado;
/// el paso a PUBLISHED es siempre manual (admin).
model PriceCollection {
  id               String                @id @default(cuid())
  /// Fuente única del archivo; null si mezcla fuentes en un mismo CSV.
  sourceId         String?
  source           PriceSource?          @relation(fields: [sourceId], references: [id])
  region           String
  collectedAt      DateTime
  importedAt       DateTime              @default(now())
  originalFilename String
  status           PriceCollectionStatus @default(DRAFT)

  totalRows    Int
  acceptedRows Int
  rejectedRows Int

  /// Email del admin que confirmó la importación.
  createdBy String?

  observations     PriceObservation[]
  referencePrices  MaterialReferencePrice[]

  @@index([status])
  @@index([sourceId])
}

/// Evidencia cruda de cada producto relevado; nunca solo el precio final.
model PriceObservation {
  id           String  @id @default(cuid())
  collectionId String
  collection   PriceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  materialId   String
  material     Material        @relation(fields: [materialId], references: [id])
  sourceId     String
  source       PriceSource     @relation(fields: [sourceId], references: [id])

  externalId String?
  title      String
  url        String

  rawPrice  Decimal @db.Decimal(14, 2)
  currency  String

  packageQuantity Decimal @db.Decimal(12, 4)
  packageUnit     String

  /// Calculado server-side: rawPrice / packageQuantity.
  normalizedUnitPrice Decimal @db.Decimal(14, 2)
  normalizedUnit      String

  seller String?
  brand  String?

  accepted        Boolean
  rejectionReason String?

  collectedAt DateTime
  metadata    Json?

  /// Hash de la identidad (source+externalId|url+collectedAt): impide
  /// duplicados silenciosos a nivel DB.
  dedupeHash String @unique

  @@index([collectionId])
  @@index([materialId])
}

/// Precio de referencia por material+región derivado de una colección
/// (mediana de observaciones aceptadas). Histórico inmutable: publicar crea
/// versiones nuevas en vez de pisar valores.
model MaterialReferencePrice {
  id         String               @id @default(cuid())
  materialId String
  material   Material             @relation(fields: [materialId], references: [id])
  /// Fuente dominante; null cuando la colección mezcla fuentes.
  sourceId   String?
  source     PriceSource?         @relation(fields: [sourceId], references: [id])
  region     String

  price Decimal @db.Decimal(14, 2)

  sampleSize        Int
  insufficientSample Boolean @default(false)
  collectionId String?
  collection   PriceCollection? @relation(fields: [collectionId], references: [id])

  validFrom DateTime
  status    ReferencePriceStatus @default(DRAFT)
  createdAt DateTime             @default(now())

  @@index([materialId, region, status])
  @@index([collectionId])
}
